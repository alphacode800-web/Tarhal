# منسوخ إلى .env وتعديل القيم حسب البيئة

# منفذ السيرفر (افتراضي 3000)
PORT=3000

# مسار ملف قاعدة البيانات SQLite (اختياري؛ الافتراضي: server/database/tarhal.db)
# DATABASE_PATH=./server/database/tarhal.db

# مفتاح خرائط جوجل (اختياري — بدونه تُستخدم خريطة OpenStreetMap المجانية)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# PING_MESSAGE=ping

# ── AI Travel Assistant (OpenAI) ──────────────────────────────────────────────
# مفتاح OpenAI — يُستخدم على السيرفر فقط ولا يُعرض في الواجهة
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_ASSISTANT_ENABLED=true

# أو أضف المفتاح من لوحة الإدارة → الذكاء الاصطناعي (يُحفظ في قاعدة البيانات)
